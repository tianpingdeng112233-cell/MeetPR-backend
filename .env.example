# MeetPR Backend — local dev env template
# Copy to .env and fill in real values for local development.
# Real secrets: see ~/Brain/wiki/projects/MeetPR/secrets-pointer.md
# Production reads env directly from the SAE runtime; do NOT load this file in prod.

NODE_ENV=development
PORT=3000

# Postgres — local dev (docker-compose) or Aliyun RDS DSN for shared dev.
# DATE columns are returned as text per ADR 004 §2 (avoid timezone drift).
DATABASE_URL=postgres://meetpr:meetpr@localhost:5432/meetpr_dev

# JWT — generate with: openssl rand -base64 48
# MUST be >= 32 chars. Rotate access and refresh secrets independently.
JWT_ACCESS_SECRET=replace-me-min-32-chars-dev-only-do-not-ship
JWT_REFRESH_SECRET=replace-me-min-32-chars-dev-only-do-not-ship
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Optional stable claims. Production may pin these during a controlled token
# migration; omit them to use meetpr-api / meetpr-client.
# JWT_ISSUER=meetpr-api
# JWT_AUDIENCE=meetpr-client

# Logging: silent | fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Rate limiting (per-IP window, applied globally)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# CORS — comma-separated origins or '*' for dev
CORS_ORIGIN=*

# Trust proxy hop count (0=none, 1=behind ALB/Nginx, 2=behind two layers)
TRUST_PROXY=0

# Activity-ledger cron (spec 018): daily missed-training settlement (04:05
# Asia/Shanghai) + 15-min session timeout sweep. Incident kill switch — set
# false to stop scheduling without a redeploy of code.
SIGNALS_CRON_ENABLED=true

# APNs push outbox consumer (spec 019). Disabled by default, so existing
# deployments do not need Apple credentials. APNS_KEY is the full .p8 PEM
# content; keep all real values in Bitwarden / SAE environment variables.
PUSH_ENABLED=false
PUSH_DAILY_DIGEST_ENABLED=false
# APNS_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# APNS_KEY_ID=replace-me
# APNS_TEAM_ID=replace-me
# APNS_BUNDLE_ID=com.example.meetpr
# APNS_ENV=sandbox

# Registration defaults to enabled outside production and disabled in production.
# For a closed production beta, pre-provision users (especially coaches). To
# temporarily enable student self-registration, set both values and use only
# E.164 phones in the allowlist. Coach self-registration remains blocked.
# REGISTRATION_ENABLED=true
# REGISTRATION_ALLOWLIST=+8613800000001,+8613800000002

# Global student identity providers. All are optional and fail closed when
# omitted. SELF_SIGNUP_ROLES never accepts coach/admin; use coached_student for
# the overseas coached flow. APPLE_CLIENT_ID is the Global app bundle/client id
# used as the identity token audience (not the APNs bundle setting above).
# SELF_SIGNUP_ROLES=coached_student
# APPLE_CLIENT_ID=com.example.meetpr.global
# GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com

# Password-reset email via Resend. Both values are optional; when either is
# omitted, forgot-password stays enumeration-safe (204) and sends no email.
# RESEND_API_KEY=re_replace-me
# EMAIL_FROM=MeetPR <no-reply@example.com>

# Sign in with Apple server key. This is a dedicated SIWA .p8 key, not APNs.
# All three are optional; token exchange/revocation is skipped unless complete.
# SIWA_KEY_ID=replace-me
# SIWA_TEAM_ID=replace-me
# SIWA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# HTTPS enforcement switch (go-live blocker), off by default. Leave false until
# the business license + ICP filing are approved and the domain TLS certificate
# is configured on the CLB/Ingress. When true, the app enforces HTTPS (426 +
# HSTS) and production startup rejects an HTTP/raw-IP PUBLIC_BASE_URL, wildcard
# CORS, or TRUST_PROXY=0. It has no effect until then.
FORCE_HTTPS=false

# Production only, required once FORCE_HTTPS=true: canonical external HTTPS URL.
# TLS must be terminated by a trusted CLB/Ingress before SAE.
# PUBLIC_BASE_URL=https://api.example.com

# Aliyun OSS — attachment upload pipeline (spec 004). All optional in dev:
# when unset, /uploads/* responds 503 UPLOADS_NOT_CONFIGURED.
# Real AK/SK: Bitwarden `MeetPR OSS AK` (least-privilege RAM user, never root AK).
# OSS_ACCESS_KEY_ID=replace-me
# OSS_ACCESS_KEY_SECRET=replace-me
# OSS_BUCKET=meetpr-videos-prod
# OSS_REGION=oss-cn-hangzhou
# OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
# OSS_ACCELERATE_ENDPOINT=https://oss-accelerate.aliyuncs.com
