# MeetPR Backend — local dev env template
# Copy to .env and fill in real values for local development.
# Real secrets: see ~/Brain/wiki/projects/MeetPR/secrets-pointer.md
# Production reads env directly from the SAE runtime; do NOT load this file in prod.

NODE_ENV=development
PORT=3000

# Postgres — local dev (docker-compose) or Aliyun RDS DSN for shared dev.
# DATE columns are returned as text per ADR 004 §2 (avoid timezone drift).
DATABASE_URL=postgres://meetpr:meetpr@localhost:5432/meetpr_dev

# JWT — generate with: openssl rand -base64 48
# MUST be >= 32 chars. Rotate access and refresh secrets independently.
JWT_ACCESS_SECRET=replace-me-min-32-chars-dev-only-do-not-ship
JWT_REFRESH_SECRET=replace-me-min-32-chars-dev-only-do-not-ship
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Optional stable claims. Production may pin these during a controlled token
# migration; omit them to use meetpr-api / meetpr-client.
# JWT_ISSUER=meetpr-api
# JWT_AUDIENCE=meetpr-client

# Logging: silent | fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Rate limiting (per-IP window, applied globally)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# CORS — comma-separated origins or '*' for dev
CORS_ORIGIN=*

# Trust proxy hop count (0=none, 1=behind ALB/Nginx, 2=behind two layers)
TRUST_PROXY=0

# Registration defaults to enabled outside production and disabled in production.
# For a closed production beta, pre-provision users (especially coaches). To
# temporarily enable student self-registration, set both values and use only
# E.164 phones in the allowlist. Coach self-registration remains blocked.
# REGISTRATION_ENABLED=true
# REGISTRATION_ALLOWLIST=+8613800000001,+8613800000002

# Production only: canonical external HTTPS URL. TLS must be terminated by a
# trusted CLB/Ingress before SAE; production startup rejects an HTTP/raw-IP URL,
# wildcard CORS, or TRUST_PROXY=0.
# PUBLIC_BASE_URL=https://api.example.com

# Aliyun OSS — attachment upload pipeline (spec 004). All optional in dev:
# when unset, /uploads/* responds 503 UPLOADS_NOT_CONFIGURED.
# Real AK/SK: Bitwarden `MeetPR OSS AK` (least-privilege RAM user, never root AK).
# OSS_ACCESS_KEY_ID=replace-me
# OSS_ACCESS_KEY_SECRET=replace-me
# OSS_BUCKET=meetpr-videos-prod
# OSS_REGION=oss-cn-hangzhou
# OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
